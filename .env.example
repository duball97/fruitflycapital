# neuPrint credentials for live queries. Never commit a real token.
NEUPRINT_SERVER=https://neuprint.janelia.org
NEUPRINT_DATASET=male-cns:v1.0
NEUPRINT_TOKEN=

# Optional local data root used by malecns-report --data-dir.
MALECNS_DATA_DIR=data/raw

# Live one-fly Brian2 provider. Build this cache with
# malecns-realtime-cache before starting malecns.brain_server.
MALECNS_REALTIME_CACHE=data/runtime/malecns-realtime-3hop
MALECNS_REALTIME_SEED=0
MALECNS_REALTIME_WINDOW_MS=50

# Optional server-side The Graph -> Uniswap habitat feed. Keep API keys out of
# the frontend; configure either GRAPH_SUBGRAPH_URL or a subgraph ID + key.
GRAPH_SUBGRAPH_URL=
GRAPH_UNISWAP_SUBGRAPH_ID=
GRAPH_API_KEY=
NEUROSWARM_MARKET_POLL_SECONDS=15
# Explicitly selected sensory mapping. Use legacy only for comparison tests.
NEUROSWARM_ENCODING_MODE=financial-sensory-v1
# JSON list, for example. tokenAddress is required so buy/sell is classified
# relative to the token represented by the habitat rather than always using
# amount0:
# [{"id":"TOKEN-A","label":"TOKEN-A","poolId":"0x...","tokenAddress":"0x..."}]
NEUROSWARM_MARKET_HABITATS=
NEUROSWARM_MARKET_LOOKBACK_SECONDS=3600
NEUROSWARM_MARKET_SWAP_LIMIT=1000

# Optional DexScreener market discovery. Discovery chooses which markets enter
# the arena; it never becomes a fly preference or a trading recommendation.
# Keep this server-side. The public endpoints do not require an API key.
NEUROSWARM_MARKET_DISCOVERY_ENABLED=false
DEXSCREENER_API_BASE_URL=https://api.dexscreener.com
DEXSCREENER_TIMEOUT_SECONDS=10
DEXSCREENER_CACHE_TTL_SECONDS=60
# Include Base and Robinhood so the live world is not Ethereum-only. Leave DEX
# IDs blank to accept each chain's native venues (Aerodrome, Uniswap, etc.).
NEUROSWARM_MARKET_CHAINS=ethereum,base,robinhood
NEUROSWARM_MARKET_DEX_IDS=
NEUROSWARM_MARKET_CORE_TARGET=100
NEUROSWARM_MARKET_RECENT_TARGET=20
# Markets physically present in Three.js versus markets receiving deep Graph
# observations. The latter is intentionally smaller for realtime performance.
NEUROSWARM_MARKET_WORLD_CAPACITY=100
NEUROSWARM_MARKET_DEEP_OBSERVER_COUNT=12
NEUROSWARM_MARKET_ROUND_SECONDS=600
NEUROSWARM_MARKET_DISCOVERY_REFRESH_SECONDS=300
# Durable Supabase cache. This is the minimum interval between discovery
# refreshes across backend restarts; the active round is served from the DB.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MARKET_TABLE=market_candidates
SUPABASE_ROUND_TABLE=market_rounds
SUPABASE_TIMEOUT_SECONDS=8
NEUROSWARM_MARKET_CACHE_TTL_SECONDS=300
NEUROSWARM_MARKET_PROFILE_LIMIT=60
NEUROSWARM_MARKET_MIN_LIQUIDITY_USD=1000
NEUROSWARM_MARKET_MIN_VOLUME_24H_USD=1000
NEUROSWARM_MARKET_MIN_PAIR_AGE_SECONDS=1800
# Optional comma-separated token addresses. Prefix non-default chains as
# chainId:address. Profile feeds are still used when this is empty.
NEUROSWARM_MARKET_DISCOVERY_TOKEN_ADDRESSES=

# Optional broad ranked-asset context. CMC never creates a habitat without an
# exact chain address that DexScreener can resolve to a real pair.
CMC_API_KEY=
CMC_LISTINGS_LIMIT=100
# Only CMC listings whose exact platform is Robinhood seed this universe.
# CMC remains a global table; this prevents Ethereum/Base/Solana/etc. rows
# from being added merely because they appear in the ranked response.
CMC_ALLOWED_CHAINS=robinhood
CMC_CACHE_TTL_SECONDS=300

# Optional server-side Uniswap Trading API key. This enables quote/calldata
# helpers only; the project has no signer or transaction broadcast path.
UNISWAP_API_KEY=

# Population behavior observer / fund decision layer. Only primary CNS bodies
# are sent to this observer; render-only follower bodies never add votes.
NEUROSWARM_SWARM_SIZE=16
######## FUND / TREASURY (safe defaults) ########
FUND_MODE=local
FUND_EXECUTION_MODE=testnet
FUND_LIVE_TRADING_CONFIRMED=false
FUND_CHAIN_ID=46630
FUND_RPC_URL=https://rpc.testnet.chain.robinhood.com
FUND_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
# The address consumed by the fund service must be the Transparent proxy,
# not the implementation address. DeployFund.s.sol prints all three addresses.
FUND_CONTRACT_ADDRESS=
FUND_PROXY_ADMIN_ADDRESS=
FUND_IMPLEMENTATION_ADDRESS=
FUND_ACCOUNTING_ASSET=WETH
FUND_WETH_ADDRESS=0x0dd1df4fdd55808c9d530c9599bea5107f6b9b4e
FUND_TEST_DEPOSIT_WEI=100000000000000
FUND_DB_PATH=data/fund/fund.db
FUND_MAX_TRADE_USD=10
FUND_MAX_DAILY_TRADE_USD=50
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_WALLET_ID=
PRIVY_WALLET_ADDRESS=
PRIVY_POLICY_ID=
CMC_API_KEY=
