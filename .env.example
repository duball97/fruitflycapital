# neuPrint credentials for live queries. Never commit a real token.
NEUPRINT_SERVER=https://neuprint.janelia.org
NEUPRINT_DATASET=male-cns:v1.0
NEUPRINT_TOKEN=

# Optional local data root used by malecns-report --data-dir.
MALECNS_DATA_DIR=data/raw

# Live one-fly Brian2 provider. Build this cache with
# malecns-realtime-cache before starting malecns.brain_server.
MALECNS_REALTIME_CACHE=data/runtime/malecns-realtime-3hop
MALECNS_REALTIME_SEED=0
MALECNS_REALTIME_WINDOW_MS=50

# Optional server-side The Graph -> Uniswap habitat feed. Keep API keys out of
# the frontend; configure either GRAPH_SUBGRAPH_URL or a subgraph ID + key.
GRAPH_SUBGRAPH_URL=
GRAPH_UNISWAP_SUBGRAPH_ID=
GRAPH_API_KEY=
NEUROSWARM_MARKET_POLL_SECONDS=15
# JSON list, for example. tokenAddress is required so buy/sell is classified
# relative to the token represented by the habitat rather than always using
# amount0:
# [{"id":"TOKEN-A","label":"TOKEN-A","poolId":"0x...","tokenAddress":"0x..."}]
NEUROSWARM_MARKET_HABITATS=
NEUROSWARM_MARKET_LOOKBACK_SECONDS=3600
NEUROSWARM_MARKET_SWAP_LIMIT=1000

# Optional server-side Uniswap Trading API key. This enables quote/calldata
# helpers only; the project has no signer or transaction broadcast path.
UNISWAP_API_KEY=
